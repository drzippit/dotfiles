#!/usr/bin/env bash

# Define options
options=(
    "Fan Profiles"
    "Power Profiles"
    "Screenshots"
    "System menu"
)

# Show menu with Walker
choice=$(printf "%s\n" "${options[@]}" | walker -d -p "Which menu?")

# Handle selection
case "$choice" in
  *Fan*)
    $HOME/.local/bin/fanprofiles
    ;;
  *Power*)
    $HOME/.local/bin/powerprofiles
    ;;
  *Screenshots*)
    $HOME/.local/bin/screenshotdmenu
    ;;
  *System*)
    $HOME/.local/bin/systemmenu
    ;;
  *)
    echo "No valid choice."
    exit 1
    ;;
esac


#!/usr/bin/env bash

# Define options
options=(
    "Suspend"
    "Reboot"
    "Power off"
    "Logout"
)

# Show menu with Walker
choice=$(printf "%s\n" "${options[@]}" | walker -d -p "What do you want to do?")

# Handle selection
case "$choice" in
  *Suspend*)
    systemctl suspend
    ;;
  *Reboot*)
    reboot
    ;;
  *Power*)
    poweroff
    ;;
  *Logout*)
    hyprctl dispatch exit
    ;;
  *)
    echo "No valid choice."
    exit 1
    ;;
esac

